# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies - 忽略node_modules文件夹
node_modules/
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 忽略照片文件夹 - 这些文件太大且会频繁变化
/public/photos/
/public/photos/*

# 忽略照片文件
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff
*.webp

# 但保留文件夹结构
!/public/photos/
!/public/photos/*/
